{
  "_title": "水果采摘",
  "_note": "单果近景：量出成熟色占比、病斑占比和果径，判断能不能采、分几级",
  "id": "fruit-picking",
  "subject": "番茄，单果近景",
  "demo": {"scene": "fruit", "variants": ["ripe", "turning", "unripe", "blemished"]},
  "train": {"model": "fruit-ripeness", "scene": "fruit", "features": ["color", "shape"], "algo": "svm"},
  "max_side": 640,
  "calibration": {"mm_per_px": 0.3},
  "quality": {"min_sharpness": 8, "brightness": [30, 225]},
  "model": "multilingual",
  "pipeline": [
    {"op": "mask", "name": "fruit", "method": "hsv",
     "ranges": [{"h": [335, 72], "s": [38, 100], "v": [32, 100]}, {"h": [72, 110], "s": [22, 62], "v": [50, 100]}],
     "open": 5, "close": 9, "fill": true, "keep_largest": 1, "min_area": 3000},
    {"op": "mask", "name": "ripe", "method": "hsv", "ranges": [{"h": [340, 18], "s": [45, 100], "v": [30, 100]}], "within": "fruit"},
    {"op": "mask", "name": "blemish", "method": "gray", "channel": "v", "below": 28, "within": "fruit", "open": 3, "min_area": 20},
    {"op": "regions", "name": "fruits", "from": "fruit", "min_area": 3000},
    {"op": "classify", "model": "fruit-ripeness", "on": "regions:fruits"}
  ],
  "draw": [
    {"mask": "ripe", "color": "#e11d48", "alpha": 0.25, "outline": false, "label": "成熟色"},
    {"mask": "blemish", "color": "#3b82f6", "alpha": 0.6, "label": "病斑"},
    {"regions": "fruits", "color": "#14b8a6", "label": "果实"}
  ],
  "measurements": {
    "fruit_count": {"label": "果实数量", "unit": "个", "decimals": 0, "compute": {"type": "count", "regions": "fruits"}},
    "ripe_ratio": {"label": "成熟色占比", "unit": "%", "decimals": 1, "guard": 2,
                   "bands": [{"max": 30, "label": "未熟"}, {"max": 70, "label": "转色"}, {"label": "成熟"}],
                   "compute": {"type": "area_ratio", "mask": "ripe", "within": "fruit"}},
    "blemish_ratio": {"label": "病斑占比", "unit": "%", "decimals": 1, "guard": 0.3, "typical": 0.4,
                      "compute": {"type": "area_ratio", "mask": "blemish", "within": "fruit"}},
    "diameter": {"label": "果径", "unit": "mm", "decimals": 0, "guard": 2, "range": [0, 150],
                 "compute": {"type": "max", "regions": "fruits", "attr": "diameter"}},
    "ripeness_class": {"label": "识别类别", "compute": {"type": "top_label", "regions": "fruits"}}
  },
  "rules": {
    "pick": {"label": "达到采摘标准",
             "when": {"all": [{"m": "ripe_ratio", "op": ">=", "value": 70}, {"m": "blemish_ratio", "op": "<=", "value": 3},
                              {"m": "diameter", "op": ">=", "value": 55}]}},
    "grade": {"label": "果实等级", "cases": [
      {"value": "一级", "when": {"all": [{"m": "ripe_ratio", "op": ">=", "value": 85}, {"m": "blemish_ratio", "op": "<=", "value": 1},
                                         {"m": "diameter", "op": ">=", "value": 65}]}},
      {"value": "二级", "when": {"all": [{"m": "ripe_ratio", "op": ">=", "value": 70}, {"m": "blemish_ratio", "op": "<=", "value": 3},
                                         {"m": "diameter", "op": ">=", "value": 55}]}},
      {"value": "等外"}]}
  },
  "questions": {
    "pick": {"type": "noul", "instructions": "这个果实现在是否应该采摘？"},
    "grade": {"type": "choice", "instructions": "这个果实属于哪个等级？",
              "criteria": {"一级": "成熟充分、几乎没有病斑、果径大", "二级": "达到采摘标准但未达一级", "等外": "未达采摘标准"}},
    "use": {"type": "choice", "instructions": "综合成熟度、病斑和大小，这个果实最合适的去向是什么？",
            "criteria": {"鲜食销售": "外观好，可以直接上市", "加工原料": "可以食用但外观或大小不适合鲜销",
                         "继续生长": "还没成熟，留在植株上", "剔除": "病斑严重，不应进入流通"}}
  },
  "bindings": {"pick": {"rule": "pick"}, "grade": {"rule": "grade"}}
}
